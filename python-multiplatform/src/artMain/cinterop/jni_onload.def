        {"PyFrozenSet_NewN", "(J)J", (void *)&f_PyFrozenSet_NewN},
        {"PySequence_ContainsN", "(JJ)I", (void *)&f_PySequence_ContainsN},
        {"PySequence_ListN", "(J)J", (void *)&f_PySequence_ListN},
        {"PySequence_TupleN", "(J)J", (void *)&f_PySequence_TupleN},
        {"PyNumber_AddN", "(JJ)J", (void *)&f_PyNumber_AddN},
