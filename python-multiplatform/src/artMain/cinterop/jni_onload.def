        {"PyDict_DelItemStringN", "(JJ)I", (void *)&f_PyDict_DelItemStringN},


        /* Cycle-collecting proxy type. See the block above pmp_proxy_traverse. */
        {"proxyCreateType", "()J", (void *)&proxy_create_type},
        {"proxyGetHandle", "(J)J", (void *)&proxy_get_handle},
        {"proxySetHandle", "(JJ)V", (void *)&proxy_set_handle},

        {"testUpcallPrimitive", "(J)J", (void *)&test_upcall_primitive},
        {"testUpcallString", "(Ljava/lang/String;)J", (void *)&test_upcall_string},
        {"testUpcallUnattached", "(J)J", (void *)&test_upcall_unattached},
        {"testThreadCreateFloor", "(J)J", (void *)&test_thread_create_floor}
    };
    (*env)->RegisterNatives(env, clazz, methods, sizeof(methods) / sizeof(methods[0]));
