/*
 * The remaining string-carrying surface.
 *
 * Every one of these used to be reached with a Kotlin `String` argument through the name-linked
 * @CName export, which does not fail cleanly -- it corrupts a pointer and kills the process
 * (ROADMAP §2). The Kotlin side now hands over an already-encoded C string address as a jlong,
 * from the intern cache for repeated identifiers and from the per-thread scratch pool for
 * arbitrary content, so these wrappers only have to cast.
 *
 * All ordinary JNI, per §3's default: several of them run arbitrary Python (module top-level
 * code, __getattr__, codec lookup), and the rest are cold enough that a promotion would buy
 * nothing.
 */
extern jlong Py_CompileString(const char*, const char*, jint);
extern jlong PyErr_SetFromErrnoWithFilename(jlong, const char*);
extern void PyErr_SyntaxLocationEx(const char*, jint, jint);
extern void PyErr_SyntaxLocation(const char*, jint);
extern jint PyErr_WarnExplicit(jlong, const char*, const char*, jint, const char*, jlong);
extern jlong PyErr_NewException(const char*, jlong, jlong);
extern jlong PyErr_NewExceptionWithDoc(const char*, const char*, jlong, jlong);
extern jint PyUnicodeTranslateError_SetReason(jlong, const char*);
extern jint Py_EnterRecursiveCall(const char*);
extern jlong PySys_GetObject(const char*);
extern jint PySys_SetObject(const char*, jlong);
extern jint PySys_AuditTuple(const char*, jlong);
extern void Py_FatalError(const char*);
extern jlong PyImport_ImportModuleNoBlock(const char*);
extern jlong PyImport_ImportModuleLevel(const char*, jlong, jlong, jlong, jint);
extern jlong PyImport_ExecCodeModule(const char*, jlong);
extern jlong PyImport_ExecCodeModuleEx(const char*, jlong, const char*);
extern jlong PyImport_ExecCodeModuleWithPathnames(const char*, jlong, const char*, const char*);
extern const char* PyImport_GetMagicTag(void);
extern jint PyImport_ImportFrozenModule(const char*);
