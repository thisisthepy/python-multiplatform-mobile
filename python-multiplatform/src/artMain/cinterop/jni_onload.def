package = python.native.ffi.jni
---
#include <jni.h>

extern void Py_Initialize(void);
extern jint Py_IsInitialized(void);
extern void Py_Finalize(void);
extern void PyErr_Clear(void);
extern jlong PyLong_FromLongLong(jlong);
extern jlong PyList_Size(jlong);
extern jint PyRun_SimpleString(const char*);
extern const char* Py_GetVersion(void);
extern jlong PyImport_ImportModule(const char*);
extern jlong PyObject_GetAttrString(jlong, const char*);
extern jlong PyErr_Occurred(void);

jlong critical_echo0(jlong x) { return x; }
jlong critical_echo1(jlong x) { return x; }
jlong critical_echo2(jlong x) { return x; }

/*
 * Same one-line body, three calling conventions, so a benchmark can subtract
 * everything except the transition itself.
 *
 * @CriticalNative gets no JNIEnv or jclass at all; @FastNative and ordinary JNI
 * both receive them, and differ only in whether ART performs the GC
 * thread-state transition around the call.
 */
jlong normal_echo(JNIEnv *env, jclass clazz, jlong x) { return x; }
jlong fast_echo(JNIEnv *env, jclass clazz, jlong x) { return x; }

/*
 * The echoes above measure a transition around a body that does nothing. Real C API calls do
 * work, and if that work dominates then the convention barely matters in practice. These wrap
 * an actual CPython function -- PyList_Size, an O(1) struct read -- under the two conventions
 * that need JNIEnv, so it can be compared against the @CriticalNative registration of
 * PyList_Size itself.
 */
jlong pylistsize_fast(JNIEnv *env, jclass clazz, jlong l) { return PyList_Size(l); }
jlong pylistsize_normal(JNIEnv *env, jclass clazz, jlong l) { return PyList_Size(l); }

/*
 * @FastNative counterparts of the migrated functions.
 *
 * Measurement (see docs/downcall-design.md) shows @CriticalNative is effectively free up to
 * API 33 and collapses at 34, while @FastNative is the reverse. Both are registered so the
 * Kotlin side can pick per API level. @FastNative keeps JNIEnv and jclass, so these need the
 * leading parameters that the critical registrations must not have.
 */
static void f_Py_Initialize(JNIEnv *e, jclass c) { Py_Initialize(); }
static jint f_Py_IsInitialized(JNIEnv *e, jclass c) { return Py_IsInitialized(); }
static void f_Py_Finalize(JNIEnv *e, jclass c) { Py_Finalize(); }
static void f_PyErr_Clear(JNIEnv *e, jclass c) { PyErr_Clear(); }
static jlong f_PyLong_FromLongLong(JNIEnv *e, jclass c, jlong v) { return PyLong_FromLongLong(v); }
static jlong f_PyList_Size(JNIEnv *e, jclass c, jlong l) { return PyList_Size(l); }
static jint f_PyRun_SimpleString(JNIEnv *e, jclass c, jlong s) { return PyRun_SimpleString((const char*)s); }
static jlong f_Py_GetVersion(JNIEnv *e, jclass c) { return (jlong)Py_GetVersion(); }
static jlong f_PyImport_ImportModule(JNIEnv *e, jclass c, jlong n) { return PyImport_ImportModule((const char*)n); }
static jlong f_PyObject_GetAttrString(JNIEnv *e, jclass c, jlong o, jlong n) { return PyObject_GetAttrString(o, (const char*)n); }
static jlong f_PyErr_Occurred(JNIEnv *e, jclass c) { return PyErr_Occurred(); }

int CustomJNI_OnLoad(JavaVM *vm, void *reserved) {
    JNIEnv *env;
    if ((*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6) != JNI_OK) {
        return JNI_ERR;
    }
    jclass clazz = (*env)->FindClass(env, "python/native/ffi/bindings");
    if (clazz == NULL) return JNI_ERR;

    JNINativeMethod methods[] = {
        {"Py_Initialize", "()V", (void *)&Py_Initialize},
        {"Py_IsInitialized", "()I", (void *)&Py_IsInitialized},
        {"Py_Finalize", "()V", (void *)&Py_Finalize},
        {"PyErr_Clear", "()V", (void *)&PyErr_Clear},
        {"PyLong_FromLongLong", "(J)J", (void *)&PyLong_FromLongLong},
        {"PyList_Size", "(J)J", (void *)&PyList_Size},
        {"PyRun_SimpleString", "(J)I", (void *)&PyRun_SimpleString},
        {"Py_GetVersion", "()J", (void *)&Py_GetVersion},
        {"PyImport_ImportModule", "(J)J", (void *)&PyImport_ImportModule},
        {"PyObject_GetAttrString", "(JJ)J", (void *)&PyObject_GetAttrString},
        {"PyErr_Occurred", "()J", (void *)&PyErr_Occurred},
        {"echo0", "(J)J", (void *)&critical_echo0},
        {"echo1", "(J)J", (void *)&critical_echo1},
        {"echo2", "(J)J", (void *)&critical_echo2},
        {"echoNormal", "(J)J", (void *)&normal_echo},
        {"echoFast", "(J)J", (void *)&fast_echo},
        {"PyList_SizeFast", "(J)J", (void *)&pylistsize_fast},
        {"PyList_SizeNormal", "(J)J", (void *)&pylistsize_normal},

        {"Py_InitializeF", "()V", (void *)&f_Py_Initialize},
        {"Py_IsInitializedF", "()I", (void *)&f_Py_IsInitialized},
        {"Py_FinalizeF", "()V", (void *)&f_Py_Finalize},
        {"PyErr_ClearF", "()V", (void *)&f_PyErr_Clear},
        {"PyLong_FromLongLongF", "(J)J", (void *)&f_PyLong_FromLongLong},
        {"PyList_SizeF", "(J)J", (void *)&f_PyList_Size},
        {"PyRun_SimpleStringF", "(J)I", (void *)&f_PyRun_SimpleString},
        {"Py_GetVersionF", "()J", (void *)&f_Py_GetVersion},
        {"PyImport_ImportModuleF", "(J)J", (void *)&f_PyImport_ImportModule},
        {"PyObject_GetAttrStringF", "(JJ)J", (void *)&f_PyObject_GetAttrString},
        {"PyErr_OccurredF", "()J", (void *)&f_PyErr_Occurred}
    };
    (*env)->RegisterNatives(env, clazz, methods, 29);
    return JNI_VERSION_1_6;
}
