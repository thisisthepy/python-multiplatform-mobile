jlong critical_echo0(jlong x) { return x; }
jlong critical_echo1(jlong x) { return x; }
jlong critical_echo2(jlong x) { return x; }

/*
 * Same one-line body, three calling conventions, so a benchmark can subtract
 * everything except the transition itself.
 *
 * @CriticalNative gets no JNIEnv or jclass at all; @FastNative and ordinary JNI
 * both receive them, and differ only in whether ART performs the GC
 * thread-state transition around the call.
 */
jlong normal_echo(JNIEnv *env, jclass clazz, jlong x) { return x; }
jlong fast_echo(JNIEnv *env, jclass clazz, jlong x) { return x; }

/*
 * The echoes above measure a transition around a body that does nothing. Real C API calls do
 * work, and if that work dominates then the convention barely matters in practice. These wrap
 * an actual CPython function -- PyList_Size, an O(1) struct read -- under the two conventions
 * that need JNIEnv, so it can be compared against the @CriticalNative registration of
 * PyList_Size itself.
 */
jlong pylistsize_fast(JNIEnv *env, jclass clazz, jlong l) { return PyList_Size(l); }
jlong pylistsize_normal(JNIEnv *env, jclass clazz, jlong l) { return PyList_Size(l); }

/*
 * @FastNative counterparts of the migrated functions.
 *
 * Measurement (see docs/downcall-design.md) shows @CriticalNative is effectively free up to
 * API 33 and collapses at 34, while @FastNative is the reverse. Both are registered so the
 * Kotlin side can pick per API level. @FastNative keeps JNIEnv and jclass, so these need the
 * leading parameters that the critical registrations must not have.
 */
static void f_Py_Initialize(JNIEnv *e, jclass c) { Py_Initialize(); }
static jint f_Py_IsInitialized(JNIEnv *e, jclass c) { return Py_IsInitialized(); }
static void f_Py_Finalize(JNIEnv *e, jclass c) { Py_Finalize(); }
static void f_PyErr_Clear(JNIEnv *e, jclass c) { PyErr_Clear(); }
static jlong f_PyLong_FromLongLong(JNIEnv *e, jclass c, jlong v) { return PyLong_FromLongLong(v); }
static jlong f_PyList_Size(JNIEnv *e, jclass c, jlong l) { return PyList_Size(l); }
static jint f_PyRun_SimpleString(JNIEnv *e, jclass c, jlong s) { return PyRun_SimpleString((const char*)s); }
static jlong f_Py_GetVersion(JNIEnv *e, jclass c) { return (jlong)Py_GetVersion(); }
static jlong f_PyImport_ImportModule(JNIEnv *e, jclass c, jlong n) { return PyImport_ImportModule((const char*)n); }
static jlong f_PyImport_ImportN(JNIEnv *e, jclass c, jlong n) { return PyImport_Import(n); }
static jlong f_PyObject_GetAttrString(JNIEnv *e, jclass c, jlong o, jlong n) { return PyObject_GetAttrString(o, (const char*)n); }
static jlong f_PyErr_Occurred(JNIEnv *e, jclass c) { return PyErr_Occurred(); }

/*
 * PyList_GetItem had no @FastNative twin, which left it @CriticalNative on every API level -- the
 * one place in the table that ignores the device axis. That is backwards above API 33: the net
 * cost of @CriticalNative there is 24.35 ns (34) and 44.05 ns (36 hardware) against @FastNative's
 * 1.97 and 3.55. It is also the per-element call of bulk list iteration, so the penalty multiplies
 * by N -- the measured 50065.89 ns for a 1000-element list on API 36 is ~50 ns per element against
 * a @CriticalNative net cost of 44.05.
 */
static jlong f_PyList_GetItemRaw(JNIEnv *e, jclass c, jlong list, jlong i) { return PyList_GetItem(list, i); }

static void f_Py_DecRefN(JNIEnv *e, jclass c, jlong o) { Py_DecRef((jlong)o); }
static void f_Py_IncRefN(JNIEnv *e, jclass c, jlong o) { Py_IncRef((jlong)o); }
static jlong f_Py_NewRefN(JNIEnv *e, jclass c, jlong o) { return Py_NewRef((jlong)o); }
static jlong f_Py_XNewRefN(JNIEnv *e, jclass c, jlong o) { return Py_XNewRef((jlong)o); }
static jint f_PyGILState_EnsureN(JNIEnv *e, jclass c) { return PyGILState_Ensure(); }
static void f_PyGILState_ReleaseN(JNIEnv *e, jclass c, jint s) { PyGILState_Release(s); }
static jlong f_PyGILState_GetThisThreadStateN(JNIEnv *e, jclass c) { return PyGILState_GetThisThreadState(); }
static jlong f_PyEval_SaveThreadN(JNIEnv *e, jclass c) { return PyEval_SaveThread(); }
static void f_PyEval_RestoreThreadN(JNIEnv *e, jclass c, jlong t) { PyEval_RestoreThread(t); }
static void f_PyEval_InitThreadsN(JNIEnv *e, jclass c) { PyEval_InitThreads(); }
static jlong f_PyThreadState_GetDictN(JNIEnv *e, jclass c) { return PyThreadState_GetDict(); }
static jlong f_PyTuple_NewN(JNIEnv *e, jclass c, jlong len) { return PyTuple_New(len); }
static jint f_PyTuple_SetItemN(JNIEnv *e, jclass c, jlong p, jlong pos, jlong o) { return PyTuple_SetItem(p, pos, o); }
static jlong f_PyDict_NewN(JNIEnv *e, jclass c) { return PyDict_New(); }
static jint f_PyDict_SetItemStringN(JNIEnv *e, jclass c, jlong p, jlong k, jlong v) { return PyDict_SetItemString(p, (const char*)k, v); }
static jint f_PyDict_SetItemN(JNIEnv *e, jclass c, jlong p, jlong k, jlong v) { return PyDict_SetItem(p, k, v); }
static jlong f_PyDict_GetItemStringN(JNIEnv *e, jclass c, jlong p, jlong k) { return PyDict_GetItemString(p, (const char*)k); }


static jlong f_PyImport_AddModuleRefN(JNIEnv *e, jclass c, jlong n) { return PyImport_AddModuleRef((const char*)n); }

/*
 * Reached from PythonTestFixture.mainGlobals, and before these were registered the second
 * object-model test on Android died with SIGSEGV at fault address 0xc24110e8 -- a truncated
 * pointer, the signature of the name-linked @CName fallback described in ROADMAP §2.
 *
 * PyImport_AddModule returns a BORROWED reference where PyImport_AddModuleRef returns a new one.
 * The two are not interchangeable at the call site and the Kotlin actual keeps that distinction.
 */
static jlong f_PyImport_AddModuleN(JNIEnv *e, jclass c, jlong n) { return PyImport_AddModule((const char*)n); }
/*
 * Borrowed reference into the interpreter's sys module dict; the caller must not release it.
 *
 * Left on the name-linked @CName fallback it did not fail loudly -- it returned a null pointer,
 * which surfaced as an NPE in GilParkingTest rather than as a crash, so it read like a missing
 * "modules" entry instead of missing wiring. Ordinary JNI, not @FastNative: sys.__dict__ lookups
 * go through PyDict_GetItemWithError, which can run a __eq__ or __hash__.
 */
static jlong f_PySys_GetObjectN(JNIEnv *e, jclass c, jlong n) { return PySys_GetObject((const char*)n); }
static void f_PyErr_SetStringN(JNIEnv *e, jclass c, jlong t, jlong m) { PyErr_SetString(t, (const char*)m); }
