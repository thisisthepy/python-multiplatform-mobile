        {"PyNumber_SubtractN", "(JJ)J", (void *)&f_PyNumber_SubtractN},
        {"PyFloat_AsDoubleN", "(J)D", (void *)&f_PyFloat_AsDoubleN},
        {"PyFloat_FromDoubleN", "(D)J", (void *)&f_PyFloat_FromDoubleN},
        {"PyLong_AsIntN", "(J)I", (void *)&f_PyLong_AsIntN},
        {"PyLong_AsLongLongN", "(J)J", (void *)&f_PyLong_AsLongLongN},
        {"PyBool_FromLongN", "(J)J", (void *)&f_PyBool_FromLongN},
        {"PyUnicode_ConcatN", "(JJ)J", (void *)&f_PyUnicode_ConcatN},
        {"PyUnicode_ContainsN", "(JJ)I", (void *)&f_PyUnicode_ContainsN},
        {"PyCallable_CheckN", "(J)I", (void *)&f_PyCallable_CheckN},
        {"PyEval_GetBuiltinsN", "()J", (void *)&f_PyEval_GetBuiltinsN},
        {"PyIter_NextN", "(J)J", (void *)&f_PyIter_NextN},
        {"Py_GetBuildInfoN", "()J", (void *)&f_Py_GetBuildInfoN},
        {"Py_GetCompilerN", "()J", (void *)&f_Py_GetCompilerN},
        {"Py_GetCopyrightN", "()J", (void *)&f_Py_GetCopyrightN},
        {"Py_GetPlatformN", "()J", (void *)&f_Py_GetPlatformN},
        {"Py_RunMainN", "()I", (void *)&f_Py_RunMainN},

        /*
         * The rest of the string-carrying surface. Every C string crosses as a jlong address the
         * Kotlin side already encoded, so none of these takes a jstring.
         */
        {"Py_CompileStringN", "(JJI)J", (void *)&f_Py_CompileStringN},
        {"PyErr_SetFromErrnoWithFilenameN", "(JJ)J", (void *)&f_PyErr_SetFromErrnoWithFilenameN},
